{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ridomin/sple/main/schemas/canonical-playlist.v1.schema.json",
  "title": "sple canonical playlist file, version 1",
  "description": "Lossless playlist export written by `sple export --format json` (ADR 0008). Export files belong to the user and are outside sple's data retention.",
  "type": "object",
  "required": ["schemaVersion", "exportedAt", "generator", "source", "playlist", "tracks", "unsupportedItems"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "exportedAt": {
      "description": "ISO 8601 timestamp in UTC.",
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "sple" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "required": ["provider", "kind"],
      "additionalProperties": false,
      "properties": {
        "provider": { "$ref": "#/$defs/providerId" },
        "kind": { "enum": ["playlist", "liked"] },
        "userId": { "type": "string" }
      }
    },
    "playlist": {
      "type": "object",
      "required": ["name", "trackCount"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "owner": {
          "type": "object",
          "required": ["id"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "displayName": { "type": "string" }
          }
        },
        "public": { "type": "boolean" },
        "collaborative": { "type": "boolean" },
        "url": { "type": "string" },
        "trackCount": {
          "description": "Number of items in this file: tracks plus unsupportedItems.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tracks": {
      "type": "array",
      "items": { "$ref": "#/$defs/track" }
    },
    "unsupportedItems": {
      "type": "array",
      "items": { "$ref": "#/$defs/unsupportedItem" }
    }
  },
  "if": {
    "properties": {
      "source": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "liked" } } }
    },
    "required": ["source"]
  },
  "then": {
    "properties": {
      "playlist": { "type": "object", "properties": { "name": { "const": "Liked Songs" } } }
    }
  },
  "$defs": {
    "providerId": {
      "description": "sple provider ID, e.g. spotify or youtube-music.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "position": {
      "description": "1-based position in the source playlist. tracks and unsupportedItems share one position space.",
      "type": "integer",
      "minimum": 1
    },
    "track": {
      "description": "CanonicalTrack (ADR 0005) plus its position.",
      "type": "object",
      "required": ["position", "title", "artists", "refs"],
      "additionalProperties": false,
      "properties": {
        "position": { "$ref": "#/$defs/position" },
        "title": { "type": "string" },
        "artists": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "album": { "type": "string" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "isrc": {
          "description": "null when the provider does not supply ISRC (Spotify since Feb 2026); absent when not resolved.",
          "type": ["string", "null"]
        },
        "addedAt": { "type": "string", "format": "date-time" },
        "refs": {
          "description": "Provider ID to provider-specific track reference.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/providerId" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unsupportedItem": {
      "type": "object",
      "required": ["position", "kind"],
      "additionalProperties": false,
      "properties": {
        "position": { "$ref": "#/$defs/position" },
        "kind": { "enum": ["local", "episode", "unavailable"] },
        "name": { "type": "string" },
        "ref": { "type": "string" }
      }
    }
  }
}
